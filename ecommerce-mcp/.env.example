# Local dev: postgresql://USER:PASSWORD@localhost:5432/ecommerce
# Production: use a hosted Postgres (Neon, Supabase, Railway) connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce"

# Razorpay TEST keys (from https://dashboard.razorpay.com/app/keys -> Test Mode)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Used by mcp-server to know where to reach the API (if run separately)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port for the standalone MCP server
MCP_PORT=8787

# Optional: shared secret agents must send to call MCP tools (recommended once deployed)
MCP_API_KEY="change-me-to-a-long-random-string"
