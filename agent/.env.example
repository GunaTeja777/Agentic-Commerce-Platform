# FastAPI Backend URL
BACKEND_URL=http://localhost:8000

# LLM Configuration (Gemini or OpenAI)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Optional OpenAI alternative
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Merchant Configuration
DEFAULT_MERCHANT_ID=1

# Agent Settings
LOG_LEVEL=INFO
